{
  "name": "oremus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Oremus – Katholische App für Gebet, Liturgie und Stundenbuch (1962 & Novus Ordo)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gabc:fetch": "node scripts/fetch-gregobase.mjs",
    "missa:fetch": "node scripts/fetch-divinum-officium.mjs",
    "officium:fetch": "node scripts/fetch-do-office.mjs",
    "psalter:fetch": "node scripts/fetch-do-psalter.mjs",
    "kyriale:fetch": "node scripts/fetch-kyriale.mjs",
    "gabc:dump": "node scripts/gregobase-from-dump.mjs",
    "propers:fetch": "node scripts/fill-proper-melodies.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.0.18",
    "@fontsource/eb-garamond": "^5.0.20",
    "exsurge": "^0.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
